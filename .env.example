# ==============================================================
# ECHO — Gnani AI Great Indian AI Internship Challenge 2026
# Environment Configuration & Safety Policy
# ==============================================================

PORT=3000

# --------------------------------------------------------------
# GNANI AI CONFIGURATION
# Supported Modes:
#   'mock' -> (DEFAULT & SAFE) 0 credits consumed. High fidelity
#             simulation, browser SpeechSynthesis/WebSpeech STT,
#             and cached audio files.
#   'live' -> Calls real Gnani Prisma v2.5 and Timbre v2.5 APIs.
#             Requires explicit user confirmation before any call.
# --------------------------------------------------------------
GNANI_MODE=mock
GNANI_API_KEY=
GNANI_ACCESS_TOKEN=
GNANI_APP_ID=

# Endpoints (Configured according to Gnani AI API platform specs)
GNANI_STT_ENDPOINT=https://api.gnani.ai/v1/voice/stt
GNANI_TTS_ENDPOINT=https://api.gnani.ai/v1/voice/tts

# --------------------------------------------------------------
# REASONING ENGINE (Bilingual Evaluation & Question Generation)
# Supported Providers:
#   'mock'         -> Deterministic pedagogical rubric evaluation (instant, 0 cost)
#   'gemini_flash' -> Google Gemini 1.5 / 2.0 Flash (free tier, excellent Indian languages)
#   'groq'         -> Ultra-fast cloud inference (Llama 3.3 70B / Qwen 2.5)
#   'evon_adapter' -> Specification layer ready for Evon v3.3 30B
# --------------------------------------------------------------
REASONING_PROVIDER=mock
GEMINI_API_KEY=
GROQ_API_KEY=

# --------------------------------------------------------------
# CREDIT MANAGEMENT & TRACKING
# --------------------------------------------------------------
TOTAL_GNANI_CREDITS=5000
CREDITS_CONSUMED=0
